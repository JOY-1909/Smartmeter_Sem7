# GridSense Environment Configuration
# Set to 'false' when connecting to real backend services
VITE_USE_MOCK_DATA=true

# Real REST API Base URL (used when VITE_USE_MOCK_DATA=false)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Real WebSocket/MQTT Bridge URL (used when VITE_USE_MOCK_DATA=false)
VITE_WS_URL=ws://localhost:8000/ws/live-metrics

# Simulation Update Frequency in milliseconds (for mock stream)
VITE_MOCK_REFRESH_RATE_MS=1000

# Default Meter ID for monitoring
VITE_DEFAULT_METER_ID=MTR-IND-KA-0942
